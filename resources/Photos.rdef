resource vector_icon { import "Photos.hvif" };
resource app_signature "application/x-vnd.airos-Photos";
resource app_flags B_SINGLE_LAUNCH;
resource app_version {
	major = 1, middle = 0, minor = 0, variety = B_APPV_FINAL, internal = 1,
	short_info = "Photos",
	long_info = "Photos for air/OS: your library by time and by people, basic edits, cameras and phones, Immich."
};
// Listed as supported (Open with, drops), never as the preferred application:
// ShowImage stays the viewer of single files. Only types the system's MIME
// database has: a type it lacks would put a stub into the package's mime_db,
// the same file other packages ship (LightCraft's image/x-adobe-dng). RAW and
// HEIC files are imported by drop, File > Import and from cameras.
resource file_types message {
	"types" = "image/jpeg",
	"types" = "image/png",
	"types" = "image/tiff",
	"types" = "image/webp",
	"types" = "image/avif"
};
