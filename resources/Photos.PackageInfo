name photos
version 1.0.0-1
architecture x86_64
summary "Your photo library: timeline, people, edits, cameras and Immich"
description "Photos keeps your pictures in one library and shows them by time: recent photos, days, months and years. It finds the faces in them with the Neural Kit and learns who is who as you name people. Basic edits (crop, rotate, straighten, exposure, contrast, colour) never touch the original, and a photo opens in PhotoCraft for bigger changes: every save there becomes a new version in Photos. JPEG, PNG, HEIC and camera RAW files (developed with LightCraft's engine) are supported. Connect a camera, a phone or a memory card and Photos opens to import everything or only what is new, and it keeps the library in sync with an Immich server in both directions."
packager "air/OS contributors"
vendor "air/OS"
copyrights { "2026 air/OS contributors" }
licenses { "MIT" }
provides {
	photos = 1.0.0
	app:Photos = 1.0.0
	cmd:photos_agent = 1.0.0
	cmd:photos_tool = 1.0.0
}
requires {
	haiku >= r1~beta5
	lib:libcurl >= 4
	lib:libsqlite3
	lib:libjpeg
	lib:libwebp
}
